{
  "name": "local-review-workflow",
  "displayName": "本地开发工作流",
  "description": "用 Cline 做后端实现，Codex/DSH 二选一作为前端规划与审查，可选 DSH 自审 + Codex 复审，并按 Git 提交验收。",
  "version": "0.5.10",
  "publisher": "local-workflow",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onView:localWorkflow.panel",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "local-workflow",
          "title": "本地开发工作流",
          "icon": "media/workflow.svg"
        }
      ]
    },
    "views": {
      "local-workflow": [
        {
          "type": "webview",
          "id": "localWorkflow.panel",
          "name": "任务",
          "contextualTitle": "本地开发工作流"
        }
      ]
    },
    "commands": [
      {
        "command": "localWorkflow.open",
        "title": "打开本地开发工作流"
      }
    ],
    "configuration": {
      "title": "本地开发工作流",
      "properties": {
        "localWorkflow.useClineAct": {
          "type": "boolean",
          "default": false,
          "description": "未单独设置的项目是否默认使用 Cline 原生 Act 供应商和模型实现代码。"
        },
        "localWorkflow.codexExecutable": {
          "type": "string",
          "default": "",
          "description": "可选的 Codex 可执行文件绝对路径。"
        },
        "localWorkflow.clineEntry": {
          "type": "string",
          "default": "",
          "description": "可选的 Cline CLI JavaScript 入口绝对路径。"
        },
        "localWorkflow.dshExecutable": {
          "type": "string",
          "default": "",
          "description": "可选的 DSH 启动器绝对路径；留空时自动查找 dsh。"
        },
        "localWorkflow.dshReviewPermissionMode": {
          "type": "string",
          "default": "danger-full-access",
          "description": "DSH 自审使用的权限预设；完全权限，允许它修复代码。"
        },
        "localWorkflow.dshReviewProfile": {
          "type": "string",
          "default": "headless",
          "description": "DSH 自审使用的 DSH profile；必须是 CLI 可用的独立 profile（默认 headless），不能使用 Electron 独占的 desktop profile。"
        },
        "localWorkflow.dshReviewApprovalPolicy": {
          "type": "string",
          "enum": [
            "ask",
            "never"
          ],
          "default": "never",
          "description": "DSH 自审的审批策略；无人值守时用 never。"
        },
        "localWorkflow.dshReviewTimeoutMinutes": {
          "type": "number",
          "default": 45,
          "minimum": 5,
          "maximum": 720,
          "description": "DSH 自审单次运行的最长分钟数。"
        },
        "localWorkflow.useDshFrontend": {
          "type": "boolean",
          "default": false,
          "description": "项目默认使用 DSH 前端；关闭时使用 Codex 前端。"
        },
        "localWorkflow.dshSessionId": {
          "type": "string",
          "default": "",
          "description": "绑定的 DSH 会话 ID，用于前端交接和状态展示。"
        },
        "localWorkflow.reviewCodex": {
          "type": "boolean",
          "default": true,
          "description": "验收前使用 Codex 复审。"
        },
        "localWorkflow.reviewDsh": {
          "type": "boolean",
          "default": false,
          "description": "验收前先使用 DSH 自审（goal 循环）。"
        },
        "localWorkflow.maxParallel": {
          "type": "string",
          "enum": [
            "1",
            "2",
            "4",
            "8",
            "unlimited"
          ],
          "enumItemLabels": [
            "无并行",
            "2",
            "4",
            "8",
            "无限制"
          ],
          "default": "2",
          "description": "本地实现者的并行上限。只有依赖就绪且写入范围互不冲突的任务才会派发。"
        },
        "localWorkflow.maxRepairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 3
        },
        "localWorkflow.initialCommit": {
          "type": "boolean",
          "default": false,
          "description": "阶段开始时是否先提交现有工作区快照，作为实现前基线。"
        },
        "localWorkflow.dshReviewApiKey": {
          "type": "string",
          "default": "",
          "description": "DSH 自审使用的 DeepSeek API key；写入后直接传给 headless DSH，不再从环境变量读取。"
        }
      }
    }
  },
  "files": [
    "extension.js",
    "workflow.js",
    "prompts.js",
    "panel.js",
    "status-panel.js",
    "codex-session.js",
    "transport.js",
    "state-machine.js",
    "hub.js",
    "settings.js",
    "binding.js",
    "cline-cli.js",
    "dsh-frontend.js",
    "dsh-review.js",
    "review-broker.js",
    "review-journal.js",
    "README.md",
    "media",
    "vendor",
    "dsh-session-info.js",
    "dsh-binding.js",
    "cline-preferences.js"
  ]
}
